// --- CONFIGURAÇÃO DO MOTOR DO PRISMA ---
datasource db {
  provider = "sqlite" // Ou "postgresql" / "mysql", dependendo do seu ambiente
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --- MODELO 1: CLIENTES / EMPRESAS ---
model Empresa {
  id           String        @id @default(uuid())
  nome         String        @unique
  criadoEm     DateTime      @default(now())
  
  // Relações reversas do Prisma (Não geram colunas no banco físico)
  dispositivos Dispositivo[]
  tickets      Ticket[]
}

// --- MODELO 2: ATIVOS / DISPOSITIVOS DE TI ---
model Dispositivo {
  id        String   @id @default(uuid())
  nome      String   // Ex: "NOTEBOOK-FINANCEIRO", "SERVIDOR-PROD"
  tipo      String   // Ex: "Notebook", "Servidor", "Impressora"
  criadoEm  DateTime @default(now())
  FinalizadoEm DateTime?

  // Chave estrangeira ligando o ativo rigidamente à sua respectiva empresa
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  
  tickets   Ticket[]
}

// --- MODELO 3: CLASSIFICAÇÃO / CATEGORIAS ---
model Categoria {
  id       String   @id @default(uuid())
  nome     String   @unique // Ex: "Redes", "Hardware", "Sistemas"
  criadoEm DateTime @default(now())
}

// --- MODELO 4: TICKETS / CHAMADOS ---
model Ticket {
  id              String        @id @default(uuid())
  numero          Int           @unique // Protocolo gerado automaticamente com 5 dígitos
  assunto         String
  descricao       String?       // Detalhes iniciais abertos pelo solicitante
  status          String        @default("A_FAZER") // Fluxo: A_FAZER, ATENDENDO, PAUSADOS, CONCLUIDO
  criadoEm        DateTime      @default(now())

  // Vínculo com a Empresa do Solicitante
  empresaId       String
  empresa         Empresa       @relation(fields: [empresaId], references: [id])

  // Vínculo opcional com o Dispositivo/Ativo afetado
  dispositivoId   String?
  dispositivo     Dispositivo?  @relation(fields: [dispositivoId], references: [id])
  
  // --- ENGENHARIA DE SLA E CRONÔMETRO ---
  tempoIniciadoEm DateTime?     // Guarda o timestamp exato de quando o técnico deu "Play"
  totalSegundos   Int           @default(0) // Acumula o tempo total gasto somando todas as sessões

  // --- NOVA RELAÇÃO: LINHA DO TEMPO DE APONTAMENTOS ---
  // Um ticket pode ter vários apontamentos ordenados por histórico para o relatório final
  apontamentos    Apontamento[]
}

// --- MODELO 5: HISTÓRICO DE INTERAÇÕES E APONTAMENTO DE HORAS ---
model Apontamento {
  id             String   @id @default(uuid())
  texto          String   // Descrição técnica do que foi executado na respectiva sessão
  segundosSessao Int      // Quantidade exata de segundos capturada pelo cronômetro nesta sessão específica
  criadoEm       DateTime @default(now()) // Data e hora em que o apontamento foi registrado

  // Chave estrangeira conectando o apontamento ao seu chamado pai
  // O 'onDelete: Cascade' garante que se um ticket for deletado, o histórico dele limpa junto para não poluir o banco
  ticketId       String
  ticket         Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}